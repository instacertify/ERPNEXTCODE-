# InstaCertify ERPNext 16.32.3 — production-style env
ERPNEXT_VERSION=v16.32.3
FRAPPE_VERSION=version-16

DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# Site / domain
SITE_NAME=instacertify.in
SITES=`instacertify.in`
FRAPPE_SITE_NAME_HEADER=instacertify.in

# Custom image built with apps.json (erpnext + hrms + instacertify)
CUSTOM_IMAGE=instacertify-erp
CUSTOM_TAG=16.32.3
PULL_POLICY=missing

# HTTP
HTTP_PUBLISH_PORT=8080
LETSENCRYPT_EMAIL=nikhil@instacertify.com

# Install defaults
ADMIN_PASSWORD=admin
INSTALL_APPS=erpnext,hrms,instacertify
