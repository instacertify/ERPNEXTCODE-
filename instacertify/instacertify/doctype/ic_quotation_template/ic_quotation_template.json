   "label": "Template Name",
   "reqd": 1,
   "unique": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "quote_type",
   "fieldtype": "Select",
   "label": "Quote Type",
   "options": "Service\nTesting\nCertificate\nRenewal\nMultiple Product\nOther",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "service",
   "fieldtype": "Link",
   "label": "Primary Service",
   "options": "IC Service Catalog"
  },
  {
   "fieldname": "currency",
   "fieldtype": "Link",
   "label": "Currency",
   "options": "Currency",
   "default": "INR"
  },
  {
   "fieldname": "force_majeure",
   "fieldtype": "Text Editor",
   "label": "Force Majeure"
  },
  {
   "fieldname": "terms_and_conditions",
   "fieldtype": "Text Editor",
   "label": "Terms and Conditions"
  },
  {
   "fieldname": "items_json",
   "fieldtype": "Long Text",
   "label": "Serialized Items JSON",
   "hidden": 1
  },
  {
   "fieldname": "created_by_user",
   "fieldtype": "Link",
   "label": "Created By",
   "options": "User",
   "default": "__user"
  },
  {
   "fieldname": "is_active",
   "fieldtype": "Check",
   "label": "Active",
   "default": 1
  },
  {
   "fieldname": "notes",
   "fieldtype": "Small Text",
   "label": "Notes"
  }
