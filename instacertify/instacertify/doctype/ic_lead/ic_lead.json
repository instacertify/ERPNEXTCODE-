 ],
 "fields": [
  {
   "fieldname": "lead_details_section",
   "fieldtype": "Section Break",
   "label": "Lead Details"
  },
  {
   "fieldname": "person_name",
   "fieldtype": "Data",
   "label": "Person Name",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "company_name",
   "fieldtype": "Data",
   "label": "Company Name",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "request_type",
   "fieldtype": "Select",
   "label": "Request Type",
   "options": "\nService Request\nTesting Request\nMixed / Multiple\nOther",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "company_size",
   "fieldtype": "Select",
   "label": "Company Size",
   "options": "\nMicro\nSmall\nMedium\nLarge",
   "in_list_view": 1
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break",
   "label": "Column Break 1"
  },
  {
   "fieldname": "country",
   "fieldtype": "Select",
   "label": "Country",
   "options": "India\nUnited States\nUnited Kingdom\nUAE\nSingapore\nGermany\nOther",
   "default": "India",
   "reqd": 1
  },
  {
   "fieldname": "state",
   "fieldtype": "Select",
   "label": "State (India)",
   "options": "Andhra Pradesh\nArunachal Pradesh\nAssam\nBihar\nChhattisgarh\nGoa\nGujarat\nHaryana\nHimachal Pradesh\nJharkhand\nKarnataka\nKerala\nMadhya Pradesh\nMaharashtra\nManipur\nMeghalaya\nMizoram\nNagaland\nOdisha\nPunjab\nRajasthan\nSikkim\nTamil Nadu\nTelangana\nTripura\nUttar Pradesh\nUttarakhand\nWest Bengal\nAndaman and Nicobar Islands\nChandigarh\nDadra and Nagar Haveli and Daman and Diu\nDelhi\nJammu and Kashmir\nLadakh\nLakshadweep\nPuducherry",
   "depends_on": "eval:doc.country=='India'"
  },
  {
   "fieldname": "phone",
   "fieldtype": "Data",
   "label": "Contact Number",
   "reqd": 1
  },
  {
   "fieldname": "email",
   "fieldtype": "Data",
   "label": "Email Address",
   "options": "Email",
   "reqd": 1
  },
  {
   "fieldname": "source_&_timeline_section",
   "fieldtype": "Section Break",
   "label": "Source & Timeline"
  },
  {
   "fieldname": "lead_source",
   "fieldtype": "Select",
   "label": "Lead Source",
   "options": "\nGoogle\nDirect Call\nLead Generated\nReferral by Existing Customer\nIndiaMART\nConsultant\nWebsite\nLinkedIn\nOther",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "consultant",
   "fieldtype": "Link",
   "label": "Consultant",
   "options": "IC Consultant",
   "depends_on": "eval:doc.lead_source=='Consultant'"
  },
  {
   "fieldname": "expected_timeline",
   "fieldtype": "Data",
   "label": "Expected Timeline"
  },
  {
   "fieldname": "column_break_2",
   "fieldtype": "Column Break",
   "label": "Column Break 2"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "New\nContacted\nQualified\nQuotation Sent\nWon\nLost\nNurture",
   "default": "New",
   "in_list_view": 1
  },
  {
   "fieldname": "assigned_to",
   "fieldtype": "Link",
   "label": "Assigned To",
   "options": "User"
  },
  {
   "fieldname": "currency",
   "fieldtype": "Link",
   "label": "Preferred Currency",
   "options": "Currency",
   "default": "INR"
  },
  {
   "fieldname": "optional_details_section",
   "fieldtype": "Section Break",
   "label": "Optional Details"
  },
  {
   "fieldname": "address",
   "fieldtype": "Small Text",
   "label": "Company Address"
  },
  {
   "fieldname": "gstin",
   "fieldtype": "Data",
   "label": "GST Details / GSTIN"
  },
  {
   "fieldname": "remarks",
   "fieldtype": "Text Editor",
   "label": "Remarks"
  },
  {
   "fieldname": "converted_customer",
   "fieldtype": "Link",
   "label": "Converted Customer",
   "options": "IC Customer Profile",
   "read_only": 1
  }
 ],
 "links": [],
 "actions": [],
 "allow_rename": 1,
